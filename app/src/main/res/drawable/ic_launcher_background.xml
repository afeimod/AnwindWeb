<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2.0（用户需求 1："图标换成这个图片"）：自适应图标背景层 ——
     薄荷绿纵向渐变（顶亮 #E7F7EE → 底深 #C8E9DD），与用户上传的
     地球仪 linbox 图标边缘同色采样，前景 ic_launcher_foreground
     缩放在 61% 安全区居中，边缘无缝融入背景。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E7F7EE"
        android:centerColor="#D9EFE5"
        android:endColor="#C8E9DD" />
</shape>
