<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 浏览器网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 下载落盘公共 Downloads/（targetSdk=28 的 legacy 应用全版本都可授予；
         MANAGE_EXTERNAL_STORAGE 作为 Android 11+ 的"所有文件访问"备选） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 虚拟键盘 / 虚拟手柄按键触觉反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 下载（DownloadManager）与 Ruffle 虚拟域资源供给 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LinBoxApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LinBox"
        tools:targetApi="31">

        <!-- v1.2.0（用户需求 4）：singleTask → singleTop —— 修复网页
             input[type=file] 上传断链。singleTask 启动模式下
             startActivityForResult 的结果在多数系统上被立即以
             RESULT_CANCELED 回收（选择器结果无法落回页面 →
             "上传的无法落位"）；singleTop 保持"不重复实例"体验，
             同时结果链路完好（文件/图片选择后正确落位到页面）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LinBox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 网页链接分享进来直接打开 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 文件共享（浏览器下载文件打开 / html 经 content:// 交给浏览器等） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
